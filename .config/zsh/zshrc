# The verified mise installer uses ~/.local/bin rather than a system directory.
# Add it once so the pinned mise binary is available in future zsh sessions.
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Load the reviewed machine tools from this checkout, even when ~/.zshrc
# is symlinked or the shell starts outside the repository. The bootstrap's
# MISE_GLOBAL_CONFIG_FILE setting applies only to its child process.
# Respect a pre-existing override rather than replacing the user's choice.
if [[ -z "${MISE_GLOBAL_CONFIG_FILE:-}" ]]; then
  _dotfiles_source=${${(%):-%x}:A}
  _dotfiles_machine_manifest="${_dotfiles_source:h:h:h}/scripts/setup/mise.toml"
  if [[ -f "$_dotfiles_machine_manifest" ]]; then
    export MISE_GLOBAL_CONFIG_FILE="$_dotfiles_machine_manifest"
  fi
  unset _dotfiles_source _dotfiles_machine_manifest
fi

if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
elif [[ -x "$HOME/.local/bin/mise" ]]; then
  eval "$("$HOME/.local/bin/mise" activate zsh)"
fi

# z is a shell function generated by zoxide, not a stand-alone executable.
# If zoxide is not installed, preserve startup without an error.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi
