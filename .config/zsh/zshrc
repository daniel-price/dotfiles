# Powerlevel10k instant prompt must load before other interactive setup.
# Keep VS Code's terminal behaviour as in the previous .cfg configuration.
if [[ -o interactive && "${TERM_PROGRAM:-}" != vscode &&
      -r "$HOME/.local/share/dotfiles/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  _dotfiles_p10k_cache="${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${USER}.zsh"
  if [[ -r "$_dotfiles_p10k_cache" ]]; then
    source "$_dotfiles_p10k_cache"
  fi
  unset _dotfiles_p10k_cache
fi

# doc: option interactivecomments | Allows pasted commands containing # comments in interactive sessions; noninteractive sessions are unaffected.
# Allow pasted commands with # comments in interactive Zsh sessions.
if [[ -o interactive ]]; then
  setopt interactivecomments
fi

# The verified mise installer uses ~/.local/bin rather than a system directory.
# Add it once so the pinned mise binary is available in future zsh sessions.
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Add personal scripts to PATH so they can be run from anywhere.
_dotfiles_bin="${${(%):-%x}:A:h:h:h}/bin"
if [[ -d "$_dotfiles_bin" && ":$PATH:" != *":$_dotfiles_bin:"* ]]; then
  export PATH="$_dotfiles_bin:$PATH"
fi
unset _dotfiles_bin

# Initialize Base and selected Profiles; all scratch variables stay function-local.
_dotfiles_zsh_dir=${${(%):-%x}:A:h}
source "$_dotfiles_zsh_dir/profiles.zsh"

# doc: prompt theme | Powerlevel10k is loaded for interactive Zsh outside VS Code when installed; otherwise the default prompt remains.
# doc: prompt font | Use a Nerd Font in your terminal to display prompt glyphs correctly.
# Use the exact reviewed Powerlevel10k prompt configuration from .cfg.
# The theme is an optional, commit-pinned mise bootstrap repository; startup
# must remain healthy when it hasn't been installed or is unavailable.
if [[ -o interactive && "${TERM_PROGRAM:-}" != vscode ]]; then
  _dotfiles_p10k_theme="$HOME/.local/share/dotfiles/powerlevel10k/powerlevel10k.zsh-theme"
  if [[ -r "$_dotfiles_p10k_theme" && -r "$_dotfiles_zsh_dir/p10k.zsh" ]]; then
    POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
    source "$_dotfiles_p10k_theme"
    source "$_dotfiles_zsh_dir/p10k.zsh"
  fi
  unset _dotfiles_p10k_theme
fi
unset _dotfiles_zsh_dir

# doc: inline autosuggestions | Bookmark-first suggestions, then command history.
# Load only in interactive shells; startup must never install dependencies.
if [[ -o interactive ]]; then
  _dotfiles_autosuggestions="${${(%):-%x}:A:h}/autosuggestions.zsh"
  if [[ -r "$_dotfiles_autosuggestions" ]]; then
    source "$_dotfiles_autosuggestions"
  fi
  unset _dotfiles_autosuggestions
fi
