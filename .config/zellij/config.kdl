// doc: note clipboard | Clipboard support uses pbcopy (macOS), wl-copy (Wayland), xclip or xsel (X11).
// doc: note navigation | Ctrl+H/J/K/L in locked mode uses the vim-zellij-navigator plugin.
keybinds clear-defaults=true {
    unbind "Alt right"
    normal {
        bind "Esc" {
            SwitchToMode "locked"
        }
        bind "Ctrl a" {
            SwitchToMode "locked"
        }
        bind "r" {
            SwitchToMode "resize"
        }
        bind "p" {
            SwitchToMode "pane"
        }
        bind "y" {
            SwitchToMode "move"
        }
        bind "t" {
            SwitchToMode "tab"
        }
        bind "s" {
            SwitchToMode "entersearch"
        }
        bind "m" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            }
            SwitchToMode "locked"
        }
        bind "q" {
            Quit
        }
    }
    locked {
        bind "Ctrl a" {
            SwitchToMode "normal"
        }
        bind "Ctrl h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus_or_tab"
                payload "left"
            }
        }
        bind "Ctrl j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "down"
            }
        }
        bind "Ctrl k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "up"
            }
        }
        bind "Ctrl l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "right"
            }
        }
    }
    // Yank chord (reuses emptied built-in "move" mode): Ctrl a → y → l|a|p
    // doc: binding move:l | Copy the most recent shell command and output (requires atuin).
    // doc: binding move:a | Copy the active pane scrollback.
    // doc: binding move:p | Open the interactive command picker (requires atuin and fzf).
    move {
        bind "l" {
            Run "bash" "-c" "bash \"$HOME/.dotfiles/bin/,copy-last\"" {
                background true
            }
            SwitchToMode "locked"
        }
        bind "a" {
            Run "bash" "-c" "bash \"$HOME/.dotfiles/bin/,copy-screen\"" {
                background true
            }
            SwitchToMode "locked"
        }
        bind "p" {
            Run "bash" "-c" "bash \"$HOME/.dotfiles/bin/,copy-pick\"" {
                floating true
                close_on_exit true
                width "80%"
                height "60%"
            }
            SwitchToMode "locked"
        }
        bind "Esc" {
            SwitchToMode "locked"
        }
        bind "Ctrl c" {
            SwitchToMode "locked"
        }
    }
    session {

    }
    resize {
        bind "esc" {
            SwitchToMode "locked"
        }
        bind "h" {
            Resize "Increase left"
        }
        bind "j" {
            Resize "Increase down"
        }
        bind "k" {
            Resize "Increase up"
        }
        bind "l" {
            Resize "Increase right"
        }
        bind "H" {
            Resize "Decrease left"
        }
        bind "J" {
            Resize "Decrease down"
        }
        bind "K" {
            Resize "Decrease up"
        }
        bind "L" {
            Resize "Decrease right"
        }
    }
    tab {
        bind "esc" {
            SwitchToMode "locked"
        }
        bind "x" {
            CloseTab
            SwitchToMode "locked"
        }
        bind "n" {
            NewTab
            SwitchToMode "locked"
        }
        bind "l" {
            GoToNextTab
            SwitchToMode "locked"
        }
        bind "h" {
            GoToPreviousTab
            SwitchToMode "locked"
        }
        bind "r" {
            SwitchToMode "RenameTab"
            TabNameInput 0
        }
        bind "1" {
            GoToTab 1
            SwitchToMode "locked"
        }
        bind "2" {
            GoToTab 2
            SwitchToMode "locked"
        }
        bind "3" {
            GoToTab 3
            SwitchToMode "locked"
        }
        bind "4" {
            GoToTab 4
            SwitchToMode "locked"
        }
        bind "5" {
            GoToTab 5
            SwitchToMode "locked"
        }
        bind "6" {
            GoToTab 6
            SwitchToMode "locked"
        }
        bind "7" {
            GoToTab 7
            SwitchToMode "locked"
        }
        bind "8" {
            GoToTab 8
            SwitchToMode "locked"
        }
        bind "9" {
            GoToTab 9
            SwitchToMode "locked"
        }
    }
    pane {
        bind "esc" {
            SwitchToMode "locked"
        }
        bind "f" {
            ToggleFocusFullscreen
            SwitchToMode "locked"
        }
        bind "r" {
            SwitchToMode "RenamePane"
            TabNameInput 0
        }
        bind "x" {
            CloseFocus
            SwitchToMode "locked"
        }
        bind "d" {
            NewPane "Down"
            SwitchToMode "locked"
        }
        bind "n" {
            NewPane "Right"
            SwitchToMode "locked"
        }
        bind "c" {
            Clear
            SwitchToMode "locked"
        }
        bind "e" {
            EditScrollback
            SwitchToMode "locked"
        }
    }
    entersearch {
        bind "esc" {
            SwitchToMode "locked"
        }
        bind "Enter" {
            SwitchToMode "search"
        }
    }
    search {
        bind "esc" {
            SwitchToMode "locked"
        }
        bind "n" {
            Search "up"
        }
        bind "N" {
            Search "down"
        }
    }
    renametab {
        bind "Enter" {
            SwitchToMode "locked"
        }
        bind "Esc" {
            UndoRenameTab
            SwitchToMode "locked"
        }
    }
    renamepane {
        bind "Enter" {
            SwitchToMode "locked"
        }
        bind "Esc" {
            UndoRenamePane
            SwitchToMode "locked"
        }
    }
}
plugins {
    status-bar {
        path "status-bar"
        mode_normal_bg "yellow"
        mode_locked_bg "red"
    }
}
show_startup_tips false
theme "classic"
default_layout "default"
default_mode "locked"
scroll_buffer_size 1000000
pane_frames true
pane_frame_style "full"

