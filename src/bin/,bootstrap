#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)

# shellcheck source=src/lib/common.sh
source "$ROOT/src/lib/common.sh"
# shellcheck source=src/lib/logging.sh
source "$ROOT/src/lib/logging.sh"
# shellcheck source=src/lib/os.sh
source "$ROOT/src/lib/os.sh"
# shellcheck source=src/lib/mise.sh
source "$ROOT/src/lib/mise.sh"
# shellcheck source=src/lib/nvim.sh
source "$ROOT/src/lib/nvim.sh"
# shellcheck source=src/lib/dotfiles.sh
source "$ROOT/src/lib/dotfiles.sh"
# shellcheck source=src/lib/machine-tools.sh
source "$ROOT/src/lib/machine-tools.sh"
# shellcheck source=src/lib/login-shell.sh
source "$ROOT/src/lib/login-shell.sh"

main() {
    MISE_VERSION='v2026.11.9'
    MISE_INSTALLER_URL="https://github.com/jdx/mise/releases/download/$MISE_VERSION/install.sh"
    MISE_INSTALLER_SHA256='60adf5460b19a791b964c414a2fff9d46990c9f2b1dfc0e4ba8c2b865f882a2b'

    export DOTFILES_VERBOSE=false
    unset DOTFILES_GUM
    local -a args=()
    local arg
    for arg in "$@"; do
        if [[ "$arg" == --verbose || "$arg" == -v ]]; then
            DOTFILES_VERBOSE=true
        else
            args+=("$arg")
        fi
    done
    set -- ${args[@]+"${args[@]}"}

    usage() {
        printf '%s\n' 'Usage: ,bootstrap [-v|--verbose] [--no-update|--help]' \
            'Offer approved update, then provision Zsh, pinned tools and optional plugins.' \
            '--verbose: show full third-party command output.' \
            '--no-update: provision checked-out version without fetching (stage-zero handoff).' \
            'Every missing component requires its own interactive approval.'
    }

    mise_version() {
        local executable=$1 output
        output=$("$executable" --version 2>/dev/null) || return 1
        printf '%s\n' "${output%% *}"
    }

    installer_sha256() {
        local platform=$1 installer=$2 output
        case "$platform" in
        debian)
            command -v sha256sum >/dev/null 2>&1 ||
                return 1
            output=$(sha256sum "$installer") || return 1
            ;;
        macos)
            command -v shasum >/dev/null 2>&1 ||
                return 1
            output=$(shasum -a 256 "$installer") || return 1
            ;;
        *) return 1 ;;
        esac
        printf '%s\n' "${output%% *}"
    }

    ensure_mise() {
        local platform=$1 target existing version installer checksum directory
        [[ -n "${HOME:-}" && -d "$HOME" ]] ||
            die 'HOME must be an existing directory before installing mise.'
        target="$HOME/.local/bin/mise"
        existing=$(command -v mise || :)
        if [[ -n "$existing" ]]; then
            version=$(mise_version "$existing") ||
                die "Found mise at $existing but could not read its version; nothing changed."
            log "Existing mise $version at $existing; skipped installation and upgrade."
            return
        fi

        if [[ -e "$target" || -L "$target" ]]; then
            [[ -f "$target" && ! -L "$target" ]] ||
                die "Mise destination exists but is not a regular file: $target"
            version=$(mise_version "$target") ||
                die "Found mise destination at $target but could not read its version; nothing changed."
            log "Existing mise $version at $target; skipped installation and upgrade."
            return
        fi
        for directory in "$HOME/.local" "$HOME/.local/bin"; do
            if [[ -e "$directory" || -L "$directory" ]]; then
                [[ -d "$directory" && ! -L "$directory" ]] ||
                    die "Mise parent path is not a regular directory: $directory"
            fi
        done

        command -v curl >/dev/null 2>&1 || die 'curl is required to download mise; install it first.'
        if ! confirm "Download mise $MISE_VERSION installer from GitHub to a temporary file and verify its SHA-256?"; then
            log 'Skipped mise installer download; mise remains unavailable.'
            return
        fi
        installer=$(mktemp "${TMPDIR:-/tmp}/mise-installer.XXXXXX") ||
            die 'Could not create a temporary mise installer file.'
        if ! run_step 'Downloading mise installer' curl --fail --location --output "$installer" "$MISE_INSTALLER_URL"; then
            rm -f -- "$installer"
            die 'Could not download the mise installer.'
        fi
        if ! checksum=$(installer_sha256 "$platform" "$installer"); then
            rm -f -- "$installer"
            die 'Could not verify the mise installer SHA-256.'
        fi
        if [[ "$checksum" != "$MISE_INSTALLER_SHA256" ]]; then
            rm -f -- "$installer"
            die 'Mise installer SHA-256 did not match; nothing installed.'
        fi
        info "Verified mise $MISE_VERSION installer."

        if ! confirm "Install mise $MISE_VERSION at $target? This creates missing parent directories and downloads the verified release binary."; then
            rm -f -- "$installer"
            log 'Skipped mise installation after verification; no mise was installed.'
            return
        fi
        if ! run_step 'Installing mise' env MISE_VERSION="$MISE_VERSION" MISE_INSTALL_PATH="$target" \
            MISE_INSTALL_FROM_GITHUB=1 MISE_INSTALL_SKIP_IF_EXISTS=1 sh "$installer"; then
            rm -f -- "$installer"
            die 'Mise installation failed; check the installer output.'
        fi
        rm -f -- "$installer"

        version=$(mise_version "$target") ||
            die "Mise was not executable at the expected path: $target"
        [[ "$version" == "${MISE_VERSION#v}" ]] ||
            die "Mise version mismatch: expected ${MISE_VERSION#v}, found $version."
        log "Installed mise $version at $target."
    }

    # Keep Neovim separate from the dotfiles checkout.
    setup_nvim() {
        local config="$HOME/.config/nvim"

        if ! "$mise" -C / exec -- nvim --version >/dev/null 2>&1; then
            log 'Neovim is not installed; skipping its configuration.'
            return 0
        fi

        if [[ ! -e "$config" ]]; then
            if ! confirm "Clone the public LazyVim configuration into $config?"; then
                log 'Neovim configuration clone declined.'
                return 0
            fi
            mkdir -p "$HOME/.config" || return 1
            run_step "Cloning Neovim configuration" git clone --branch main --single-branch "$NVIM_CONFIG_REMOTE" "$config" ||
                { log 'Could not clone the LazyVim configuration.'; return 1; }
        fi

        nvim_validate_checkout "$config" || return 1
        nvim_sync_checkout "$config" --allow-offline || return 1

        nvim_bootstrap_plugins "$mise" "$config" "$ROOT/src/lib" || return 1
        info 'Neovim configuration and locked plugins synchronised.'
    }

    case "${1:-}" in
    -h | --help)
        [[ $# -eq 1 ]] || die 'Unexpected extra argument.'
        usage
        exit 0
        ;;
    --no-update)
        [[ $# -eq 1 ]] || die 'Unexpected extra argument.'
        ;;
    '')
        [[ $# -eq 0 ]] || die 'Unexpected argument.'
        logging_init || die 'Could not create a private bootstrap log.'
        # The checkout can replace this file during fast-forward. Run the
        # coordinator entirely in memory, then execute the new checkout code.
        DOTFILES_BOOTSTRAP_ROOT="$ROOT" exec bash -c '
        set -euo pipefail
        root=$DOTFILES_BOOTSTRAP_ROOT
        bash "$root/src/lib/setup/update.sh" --apply --require-current
        [[ "$(git -C "$root" symbolic-ref --quiet --short HEAD)" == main ]] || {
            printf "[error] Checkout is not on main; bootstrap skipped.\\n" >&2
            exit 1
        }
        [[ "$(git -C "$root" rev-parse HEAD)" == "$(git -C "$root" rev-parse refs/remotes/origin/main)" ]] || {
            printf "[error] Checkout is not at fetched origin/main; bootstrap skipped.\\n" >&2
            exit 1
        }
        [[ -z "$(git -C "$root" status --porcelain --untracked-files=all)" ]] || {
            printf "[error] Checkout has uncommitted changes; bootstrap skipped.\\n" >&2
            exit 1
        }
        if [[ "$DOTFILES_VERBOSE" == true ]]; then
            exec bash "$root/src/bin/,bootstrap" --no-update --verbose
        fi
        exec bash "$root/src/bin/,bootstrap" --no-update
    ' dotfiles-bootstrap
        ;;
    *) die 'Unknown argument. Use --help for usage.' ;;
    esac
    logging_init || die 'Could not create a private bootstrap log.'
    # shellcheck disable=SC2119
    platform=$(detect_os) || die 'Unsupported platform.'
    info "Detected platform: $platform."

    # Explicit --no-update provisioning can run from an existing feature checkout.
    if command -v git >/dev/null 2>&1 &&
        [[ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null || :)" == "$ROOT" ]]; then
        checkout_branch=$(git -C "$ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || :)
        if [[ "$checkout_branch" != main ]]; then
            log "Running bootstrap from ${checkout_branch:-detached HEAD} without updating."
        fi
    fi
    ensure_mise "$platform"

    if ! mise=$(mise_command); then
        log 'Mise is not installed; later provisioning was skipped.'
        exit 0
    fi
    mise_supports_dot "$mise" || die 'mise 2026.11.9 or newer is required for native machine bootstrap.'
    # Run from / so the checkout's root mise.toml (dev tooling) is never loaded.
    # The single reviewed machine config is the only global config for these calls.
    export MISE_GLOBAL_CONFIG_FILE="$ROOT/src/mise.toml"
    [[ -f "$MISE_GLOBAL_CONFIG_FILE" ]] || die 'Missing declarative machine config.'

    # Fail closed on unpinned or undeclared entries before package or dotfile setup.
    tool_specs=$(machine_tool_specs "$mise" "$ROOT/src/home/.config/mise/base-tools.toml") ||
        die 'Could not read the reviewed machine tool declarations.'

    # Prerequisites: make the pinned cosmetic UI tool available to this Bash process.
    # A failed or declined Gum install never stops the machine setup.
    local installed=0 unchanged=0 skipped=0 gum_spec='' gum_status gum_ready=false gum_path
    while IFS= read -r spec; do
        case "$spec" in gum@*) gum_spec=$spec ;; esac
    done <<<"$tool_specs"
    if [[ -n "$gum_spec" ]]; then
        if "$mise" -C / install --dry-run-code "$gum_spec" >/dev/null 2>&1; then
            gum_ready=true
            unchanged=$((unchanged + 1))
        else
            gum_status=$?
            if ((gum_status == 1)); then
                if confirm "Install missing $gum_spec for progress indicators?"; then
                    if run_step 'Installing Gum' "$mise" -C / install "$gum_spec" &&
                        run_concise "$mise" -C / install --dry-run-code "$gum_spec"; then
                        gum_ready=true
                        installed=$((installed + 1))
                    else
                        warn 'Gum installation could not be verified; using text progress.'
                    fi
                else
                    log "Skipped $gum_spec installation."
                    skipped=$((skipped + 1))
                fi
            else
                warn "Could not inspect $gum_spec; using text progress."
            fi
        fi
        # Resolve the executable under the machine manifest now. Optional setup
        # helpers select other manifests, so do not invoke Gum via mise later.
        if [[ "$gum_ready" == true ]]; then
            if gum_path=$("$mise" -C / exec -- sh -c 'command -v gum') && [[ -x "$gum_path" ]]; then
                export DOTFILES_GUM="$gum_path"
            else
                warn 'Gum is not executable; using plain-text progress.'
            fi
        fi
    fi

    # Normal provisioning starts here; no shell restart is needed.
    # Package provisioning is a single reviewed mise operation. On Pop!_OS
    # it includes Ghostty's unofficial mkasberg PPA, so always show the preview
    # and require approval before changing packages or APT sources.
    if "$mise" -C / bootstrap packages status --missing >/dev/null 2>&1; then
        info 'Reviewed OS packages are already installed.'
    else
        "$mise" -C / bootstrap packages apply --dry-run ||
            die 'Could not preview OS package installation.'
        if confirm 'Install missing OS packages (Zsh and Ghostty; on Linux, Ghostty uses the unofficial mkasberg PPA for future updates)?'; then
            "$mise" -C / bootstrap packages apply --yes ||
                die 'mise could not install the reviewed OS packages.'
            if ! command -v zsh >/dev/null 2>&1 || ! zsh --version >/dev/null 2>&1; then
                die 'OS package installation finished but zsh is still unavailable.'
            fi
        else
            log 'Skipped OS package installation.'
        fi
    fi

    # Provision tools first: dotfile status is read through the pinned jq.
    # Iterate via fd 3 to leave terminal stdin available for per-tool approval.
    while IFS= read -r spec <&3; do
        [[ -n "$spec" ]] || continue
        case "$spec" in gum@*) continue ;; esac
        if run_concise "$mise" -C / install --dry-run-code "$spec"; then
            unchanged=$((unchanged + 1))
            continue
        else
            status=$?
        fi
        [[ "$status" -eq 1 ]] || die "Could not inspect the installed $spec version."
        if confirm "Install missing $spec from the reviewed machine manifest?"; then
            run_step "Installing $spec" "$mise" -C / install "$spec" || die "mise could not install $spec."
            run_concise "$mise" -C / install --dry-run-code "$spec" ||
                die "mise did not report $spec installed after the approved command."
            installed=$((installed + 1))
        else
            log "Skipped $spec installation."
            skipped=$((skipped + 1))
        fi
    done 3<<<"$tool_specs"
    printf '✓ mise tools: %s already installed, %s installed, %s skipped.\n' "$unchanged" "$installed" "$skipped"


    # Each configured target is handled independently. A conflict never prevents
    # safe targets such as ~/.zshrc from being offered for installation.
    dotfiles_status='ok'
    if ! apply_reviewed_dotfiles "$mise"; then
        dotfiles_status='failed'
    fi

    # Optional Zsh components are independent of the ~/.zshrc dotfile deployment.
    # They are consent-gated individually and can be installed even if a dotfile
    # conflict was skipped. Only require that Zsh itself is available.
    if command -v zsh >/dev/null 2>&1 && zsh --version >/dev/null 2>&1; then
        bash "$ROOT/src/lib/setup/setup-prompt.sh" --apply ||
            die "Optional prompt setup failed; check the preceding error."
        bash "$ROOT/src/lib/setup/setup-fonts.sh" --apply ||
            die "Optional font setup failed; check the preceding error."
        bash "$ROOT/src/lib/setup/setup-autosuggestions.sh" --apply ||
            die "Optional autosuggestions setup failed; check the preceding error."
    else
        log 'Skipping optional Zsh components: Zsh is unavailable.'
    fi

    # Keep Neovim failures visible without blocking unrelated setup.
    nvim_status='ok'
    if ! setup_nvim; then
        nvim_status='failed'
    fi

    # Desktop keyboard preferences are independent of mise-managed dotfiles.
    # The helper only offers a mapping for a detected supported Linux desktop.
    bash "$ROOT/src/lib/setup/keyboard.sh" --apply ||
        die "Keyboard setup failed; check the preceding error."

    # Changing the login shell is independent of package and dotfile setup.
    # Run this last so any earlier approval answers cannot apply to chsh.
    # chsh changes only this user's login account and may ask for a password.
    offer_default_zsh "$platform" /etc/shells

    if [[ "$dotfiles_status" == failed || "$nvim_status" == failed ]]; then
        error "Bootstrap complete. Dotfiles: $dotfiles_status. Log: $DOTFILES_LOG_FILE"
    else
        printf '✓ Bootstrap complete. Dotfiles: %s.\n' "$dotfiles_status"
    fi
    if [[ "$dotfiles_status" == failed ]]; then
        printf '[error] Bootstrap completed with unresolved dotfile conflicts or setup failures.\n' >&2
    fi
    if [[ "$nvim_status" == failed ]]; then
        printf '[error] Bootstrap completed with Neovim setup failure.\n' >&2
    fi
    if [[ "$dotfiles_status" == failed || "$nvim_status" == failed ]]; then
        return 1
    fi
}

main "$@"
