#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)

# shellcheck source=lib/common.sh
source "$ROOT/lib/common.sh"
# shellcheck source=lib/mise.sh
source "$ROOT/lib/mise.sh"
# shellcheck source=lib/nvim.sh
source "$ROOT/lib/nvim.sh"

main() {
    local config="$HOME/.config/nvim"
    local mise changes

    if [[ "${1:-}" == --help && $# -eq 1 ]]; then
        printf '%s\n' 'Usage: ,nvim-update' \
            'Approve updating LazyVim plugins, validate, commit lazy-lock.json and push main.' \
            'Requires a clean main checkout. Failed validation restores previous plugins.'
        return 0
    fi
    [[ $# -eq 0 ]] || die 'Unexpected argument. Use --help for usage.'

    nvim_validate_checkout "$config" || die "Neovim checkout validation failed."

    mise=$(mise_command) || die 'Mise is not installed.'
    export MISE_GLOBAL_CONFIG_FILE="$ROOT/setup/mise.toml"
    "$mise" -C / exec -- nvim --version >/dev/null ||
        die 'Pinned Neovim is not installed.'

    if ! confirm 'Update Neovim plugins, validate, commit lazy-lock.json and push main?'; then
        log 'No changes made.'
        return 0
    fi

    nvim_sync_checkout "$config" || die "Neovim checkout sync failed."

    # A failed update or validation restores the previous tracked lockfile and
    # attempts to restore plugins; never push a failed upgrade.
    rollback() {
        local failed=0
        git -C "$config" restore -- lazy-lock.json || failed=1
        "$mise" -C / exec -- nvim --headless -c 'Lazy! restore' -c 'qa!' ||
            failed=1
        if [[ "$failed" -eq 0 ]]; then
            log 'Restored previous lockfile and plugin versions.'
        else
            printf '[error] Rollback was incomplete; inspect LazyVim manually.\n' >&2
        fi
    }

    if ! "$mise" -C / exec -- nvim --headless -c 'Lazy! update' -c 'qa!'; then
        rollback
        die 'Neovim plugin update failed; nothing pushed.'
    fi

    if ! nvim_verify_plugins "$mise"; then
        rollback
        die 'Neovim validation failed; nothing pushed.'
    fi

    changes=$(git -C "$config" status --porcelain --untracked-files=all)
    if [[ -z "$changes" ]]; then
        log 'Plugins are already up to date. No commit or push needed.'
        return 0
    fi
    if [[ "$changes" != ' M lazy-lock.json' && "$changes" != 'M  lazy-lock.json' ]]; then
        rollback
        die 'Plugin update changed unexpected files; nothing pushed.'
    fi

    git -C "$config" add -- lazy-lock.json ||
        die 'Could not stage lazy-lock.json.'
    git -C "$config" commit -m 'chore(nvim): update locked plugins' -- lazy-lock.json ||
        die 'Could not commit lazy-lock.json.'
    if ! git -C "$config" push origin main; then
        die 'Push failed; the validated local commit was preserved.'
    fi
    log 'Neovim plugins updated, validated, committed and pushed.'
}

main "$@"
