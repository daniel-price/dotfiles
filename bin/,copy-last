#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)

IFS=$'\n\t'

# shellcheck source=lib/copy_to_clipboard
source "$ROOT/lib/copy_to_clipboard"
# shellcheck source=lib/format_cmd_output
source "$ROOT/lib/format_cmd_output"
# shellcheck source=lib/zellij_dump_screen
source "$ROOT/lib/zellij_dump_screen"
# shellcheck source=lib/extract_last_output
source "$ROOT/lib/extract_last_output"

main() {
    _is_copy_cmd() {
      [[ "$1" == ,copy-last || "$1" == ,copy-screen || "$1" == ,copy-pick ||
        "$1" == *',copy-last'* || "$1" == *',copy-screen'* || "$1" == *',copy-pick'* ]]
    }

    cmd=$(atuin history last --cmd-only 2>/dev/null || true)
    # Walk back a few entries if the newest is a copy helper (typed invocation)
    if _is_copy_cmd "${cmd:-}"; then
      # Newest first (-r false): skip copy helpers
      cmd=$(atuin history list --cmd-only -r false 2>/dev/null | while IFS= read -r line; do
        _is_copy_cmd "$line" && continue
        printf '%s\n' "$line"
        break
      done)
    fi

    if [[ -z "${cmd:-}" ]]; then
      printf 'no previous command in atuin history\n' >&2
      exit 1
    fi

    output=""
    if out=$(atuin output search --limit 1 --style plain -- "$cmd" 2>/dev/null) && [[ -n "$out" ]]; then
      output=$out
    fi

    if [[ -z "$output" ]] && dump=$(zellij_dump_screen 2>/dev/null); then
      output=$(printf '%s\n' "$dump" | extract_last_output "$cmd" || true)
    fi

    if [[ -z "$output" ]]; then
      printf 'warning: no output found; copying command only\n' >&2
    fi

    format_cmd_output "$cmd" "$output" | copy_to_clipboard
}

main "$@"
