#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)

# shellcheck source=scripts/lib/common.sh
source "$ROOT/scripts/lib/common.sh"
# shellcheck source=scripts/lib/os.sh
source "$ROOT/scripts/lib/os.sh"
# shellcheck source=scripts/lib/mise.sh
source "$ROOT/scripts/lib/mise.sh"
# shellcheck source=scripts/lib/machine-tools.sh
source "$ROOT/scripts/lib/machine-tools.sh"
# shellcheck source=scripts/lib/login-shell.sh
source "$ROOT/scripts/lib/login-shell.sh"

main() {
    MISE_VERSION='v2026.11.9'
    MISE_INSTALLER_URL="https://github.com/jdx/mise/releases/download/$MISE_VERSION/install.sh"
    MISE_INSTALLER_SHA256='60adf5460b19a791b964c414a2fff9d46990c9f2b1dfc0e4ba8c2b865f882a2b'

    usage() {
        printf '%s\n' 'Usage: ,bootstrap [--no-update|--help]' \
            'Offer approved update, then provision Zsh, pinned tools and optional plugins.' \
            '--no-update: provision checked-out version without fetching (stage-zero handoff).' \
            'Every missing component requires its own interactive approval.'
    }

    mise_version() {
        local executable=$1 output
        output=$("$executable" --version 2>/dev/null) || return 1
        printf '%s\n' "${output%% *}"
    }

    installer_sha256() {
        local platform=$1 installer=$2 output
        case "$platform" in
        debian)
            command -v sha256sum >/dev/null 2>&1 ||
                return 1
            output=$(sha256sum "$installer") || return 1
            ;;
        macos)
            command -v shasum >/dev/null 2>&1 ||
                return 1
            output=$(shasum -a 256 "$installer") || return 1
            ;;
        *) return 1 ;;
        esac
        printf '%s\n' "${output%% *}"
    }

    ensure_mise() {
        local platform=$1 target existing version installer checksum directory
        [[ -n "${HOME:-}" && -d "$HOME" ]] ||
            die 'HOME must be an existing directory before installing mise.'
        target="$HOME/.local/bin/mise"
        existing=$(command -v mise || :)
        if [[ -n "$existing" ]]; then
            version=$(mise_version "$existing") ||
                die "Found mise at $existing but could not read its version; nothing changed."
            log "Existing mise $version at $existing; skipped installation and upgrade."
            return
        fi

        if [[ -e "$target" || -L "$target" ]]; then
            [[ -f "$target" && ! -L "$target" ]] ||
                die "Mise destination exists but is not a regular file: $target"
            version=$(mise_version "$target") ||
                die "Found mise destination at $target but could not read its version; nothing changed."
            log "Existing mise $version at $target; skipped installation and upgrade."
            return
        fi
        for directory in "$HOME/.local" "$HOME/.local/bin"; do
            if [[ -e "$directory" || -L "$directory" ]]; then
                [[ -d "$directory" && ! -L "$directory" ]] ||
                    die "Mise parent path is not a regular directory: $directory"
            fi
        done

        command -v curl >/dev/null 2>&1 || die 'curl is required to download mise; install it first.'
        if ! confirm "Download mise $MISE_VERSION installer from GitHub to a temporary file and verify its SHA-256?"; then
            log 'Skipped mise installer download; mise remains unavailable.'
            return
        fi
        installer=$(mktemp "${TMPDIR:-/tmp}/mise-installer.XXXXXX") ||
            die 'Could not create a temporary mise installer file.'
        if ! curl --fail --location --output "$installer" "$MISE_INSTALLER_URL"; then
            rm -f -- "$installer"
            die 'Could not download the mise installer.'
        fi
        if ! checksum=$(installer_sha256 "$platform" "$installer"); then
            rm -f -- "$installer"
            die 'Could not verify the mise installer SHA-256.'
        fi
        if [[ "$checksum" != "$MISE_INSTALLER_SHA256" ]]; then
            rm -f -- "$installer"
            die 'Mise installer SHA-256 did not match; nothing installed.'
        fi
        log "Verified mise $MISE_VERSION installer."

        if ! confirm "Install mise $MISE_VERSION at $target? This creates missing parent directories and downloads the verified release binary."; then
            rm -f -- "$installer"
            log 'Skipped mise installation after verification; no mise was installed.'
            return
        fi
        if ! MISE_VERSION="$MISE_VERSION" MISE_INSTALL_PATH="$target" \
            MISE_INSTALL_FROM_GITHUB=1 MISE_INSTALL_SKIP_IF_EXISTS=1 sh "$installer"; then
            rm -f -- "$installer"
            die 'Mise installation failed; check the installer output.'
        fi
        rm -f -- "$installer"

        version=$(mise_version "$target") ||
            die "Mise was not executable at the expected path: $target"
        [[ "$version" == "${MISE_VERSION#v}" ]] ||
            die "Mise version mismatch: expected ${MISE_VERSION#v}, found $version."
        log "Installed mise $version at $target."
    }


    # Reconcile the independent, public Neovim config after mise installs nvim.
    # Never replace a foreign config or discard local commits/changes.
    setup_nvim() {
        local config="$HOME/.config/nvim"
        local remote='https://github.com/daniel-price/lazyvim.git'
        local actual lock_before verify

        if ! "$mise" -C / exec -- nvim --version >/dev/null 2>&1; then
            log 'Neovim is not installed; skipping its configuration.'
            return 0
        fi

        if [[ ! -e "$config" && ! -L "$config" ]]; then
            if ! confirm "Clone the public LazyVim configuration into $config?"; then
                log 'Neovim configuration clone declined.'
                return 0
            fi
            mkdir -p "$HOME/.config" || return 1
            git clone --branch main --single-branch "$remote" "$config" ||
                { log 'Could not clone the LazyVim configuration.'; return 1; }
        fi

        if [[ -L "$config" || ! -d "$config" ]] ||
            [[ "$(git -C "$config" rev-parse --show-toplevel 2>/dev/null || :)" != "$(cd "$config" && pwd -P)" ]]; then
            log "Neovim configuration conflict at $config; refusing to overwrite it."
            return 1
        fi
        actual=$(git -C "$config" remote get-url origin 2>/dev/null) || {
            log 'Neovim checkout has no origin remote.'
            return 1
        }
        case "$actual" in
        "$remote" | 'https://github.com/daniel-price/lazyvim') ;;
        *) log "Unexpected Neovim origin: $actual"; return 1 ;;
        esac
        [[ "$(git -C "$config" symbolic-ref --quiet --short HEAD 2>/dev/null || :)" == main ]] ||
            { log 'Neovim checkout must be on main; leaving it untouched.'; return 1; }
        [[ -z "$(git -C "$config" status --porcelain --untracked-files=all)" ]] ||
            { log 'Neovim checkout has uncommitted changes; skipping its entire sync.'; return 1; }

        if git -C "$config" fetch origin main; then
            if git -C "$config" merge-base --is-ancestor HEAD refs/remotes/origin/main; then
                git -C "$config" merge --ff-only refs/remotes/origin/main ||
                    { log 'Could not fast-forward Neovim main.'; return 1; }
            elif git -C "$config" merge-base --is-ancestor refs/remotes/origin/main HEAD; then
                log 'Neovim has unpushed local commits; retaining them.'
            else
                log 'Neovim main has diverged from origin/main; resolve it manually.'
                return 1
            fi
        else
            log 'Neovim fetch failed (possibly offline); using the existing clean checkout.'
        fi

        [[ -f "$config/lazy-lock.json" ]] ||
            { log 'Neovim lazy-lock.json is missing.'; return 1; }
        lock_before=$(git -C "$config" hash-object lazy-lock.json) || return 1

        # Lazy restore uses the lockfile; sync/update would advance plugins.
        # The final check also refuses missing lock entries or failed checkouts.
        verify='lua local ok,err=pcall(function() local cfg=require("lazy.core.config"); local lock=vim.json.decode(table.concat(vim.fn.readfile(vim.fn.stdpath("config").."/lazy-lock.json"),"\n")); for name,p in pairs(cfg.plugins) do if not (p._ and p._.is_local) then local want=lock[name]; assert(want and want.commit, "Plugin missing from lazy-lock.json: "..name); assert(vim.fn.isdirectory(p.dir)==1, "Plugin not installed: "..name); local got=vim.fn.systemlist({"git","-C",p.dir,"rev-parse","HEAD"})[1]; assert(vim.v.shell_error==0 and got==want.commit, "Plugin does not match lockfile: "..name) end end end); if not ok then vim.api.nvim_err_writeln(err); vim.cmd("cquit 1") end'
        if ! "$mise" -C / exec -- nvim --headless \
            -c 'Lazy! restore' -c 'Lazy! clean' -c "$verify" -c 'qa!'; then
            log 'Neovim plugin restore or lockfile verification failed.'
            return 1
        fi
        if [[ "$(git -C "$config" hash-object lazy-lock.json)" != "$lock_before" ]]; then
            log 'Neovim restore unexpectedly changed lazy-lock.json.'
            return 1
        fi

        # LazyVim owns language-tool and parser declarations. Loading their
        # plugins triggers their configured install-missing behaviour.
        if ! "$mise" -C / exec -- nvim --headless \
            -c 'lua require("lazy").load({plugins={"mason.nvim","mason-lspconfig.nvim","nvim-treesitter"}})' \
            -c 'qa!'; then
            log 'Neovim Mason/Tree-sitter initialisation failed.'
            return 1
        fi
        log 'Neovim configuration and locked plugins synchronised.'
    }

    case "${1:-}" in
    -h | --help)
        [[ $# -eq 1 ]] || die 'Unexpected extra argument.'
        usage
        exit 0
        ;;
    --no-update)
        [[ $# -eq 1 ]] || die 'Unexpected extra argument.'
        ;;
    '')
        [[ $# -eq 0 ]] || die 'Unexpected argument.'
        # The checkout can replace this file during fast-forward. Run the
        # coordinator entirely in memory, then execute the new checkout code.
        DOTFILES_BOOTSTRAP_ROOT="$ROOT" exec bash -c '
        set -euo pipefail
        root=$DOTFILES_BOOTSTRAP_ROOT
        bash "$root/scripts/setup/update.sh" --apply --require-current
        [[ "$(git -C "$root" symbolic-ref --quiet --short HEAD)" == main ]] || {
            printf "[error] Checkout is not on main; bootstrap skipped.\\n" >&2
            exit 1
        }
        [[ "$(git -C "$root" rev-parse HEAD)" == "$(git -C "$root" rev-parse refs/remotes/origin/main)" ]] || {
            printf "[error] Checkout is not at fetched origin/main; bootstrap skipped.\\n" >&2
            exit 1
        }
        [[ -z "$(git -C "$root" status --porcelain --untracked-files=all)" ]] || {
            printf "[error] Checkout has uncommitted changes; bootstrap skipped.\\n" >&2
            exit 1
        }
        exec bash "$root/bin/,bootstrap" --no-update
    ' dotfiles-bootstrap
        ;;
    *) die 'Unknown argument. Use --help for usage.' ;;
    esac
    # shellcheck disable=SC2119
    platform=$(detect_os) || die 'Unsupported platform.'
    log "Detected platform: $platform."

    # Explicit --no-update provisioning can run from an existing feature checkout.
    if command -v git >/dev/null 2>&1 &&
        [[ "$(git -C "$ROOT" rev-parse --show-toplevel 2>/dev/null || :)" == "$ROOT" ]]; then
        checkout_branch=$(git -C "$ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || :)
        if [[ "$checkout_branch" != main ]]; then
            log "Running bootstrap from ${checkout_branch:-detached HEAD} without updating."
        fi
    fi
    ensure_mise "$platform"

    if ! mise=$(mise_command); then
        log 'Mise is not installed; later provisioning was skipped.'
        exit 0
    fi
    mise_supports_dot "$mise" || die 'mise 2026.11.9 or newer is required for native machine bootstrap.'
    # Run from / so the checkout's root mise.toml (dev tooling) is never loaded.
    # The single reviewed machine config is the only global config for these calls.
    export MISE_GLOBAL_CONFIG_FILE="$ROOT/scripts/setup/mise.toml"
    [[ -f "$MISE_GLOBAL_CONFIG_FILE" ]] || die 'Missing declarative machine config.'

    # Fail closed on unpinned or undeclared entries before package or dotfile setup.
    tool_specs=$(machine_tool_specs "$mise" "$MISE_GLOBAL_CONFIG_FILE") ||
        die 'Could not read the reviewed machine tool declarations.'

    # Package provisioning is a single reviewed mise operation. On Pop!_OS
    # it includes Ghostty's unofficial mkasberg PPA, so always show the preview
    # and require approval before changing packages or APT sources.
    if "$mise" -C / bootstrap packages status --missing >/dev/null 2>&1; then
        log 'Reviewed OS packages are already installed.'
    else
        "$mise" -C / bootstrap packages apply --dry-run ||
            die 'Could not preview OS package installation.'
        if confirm 'Install missing OS packages (Zsh and Ghostty; on Linux, Ghostty uses the unofficial mkasberg PPA for future updates)?'; then
            "$mise" -C / bootstrap packages apply --yes ||
                die 'mise could not install the reviewed OS packages.'
            if ! command -v zsh >/dev/null 2>&1 || ! zsh --version >/dev/null 2>&1; then
                die 'OS package installation finished but zsh is still unavailable.'
            fi
        else
            log 'Skipped OS package installation.'
        fi
    fi

    # Mise owns the reviewed dotfiles. Preview and require explicit approval before
    # applying; --yes skips mise's second prompt, never its conflict checks.
    # Apply before tool provisioning so a new Zsh session can activate mise.
    # A conflict must not block otherwise independent tool installation.
    zsh_config_status='skipped (zsh unavailable)'
    zsh_target="$HOME/.zshrc"
    zsh_source="$ROOT/.config/zsh/zshrc"
    # Only the Zellij regular-file conflict is auto-migrated. Keep a recoverable
    # original, never force every dotfile or replace foreign symlinks.
    apply_reviewed_dotfiles() {
        local target="$HOME/.config/zellij/config.kdl"
        local backup='' timestamp suffix=0

        if [[ -L "$target" ]]; then
            if [[ ! "$target" -ef "$ROOT/.config/zellij/config.kdl" ]]; then
                log "Zellij config is a foreign symlink; leaving it untouched: $target"
                return 1
            fi
        elif [[ -e "$target" ]]; then
            if [[ ! -f "$target" ]]; then
                log "Zellij config is not a regular file; leaving it untouched: $target"
                return 1
            fi
            timestamp=$(date +%Y%m%d-%H%M%S)
            backup="$target.backup-$timestamp"
            while [[ -e "$backup" || -L "$backup" ]]; do
                suffix=$((suffix + 1))
                backup="$target.backup-$timestamp-$suffix"
            done
            # Move instead of copy, preserving the original exactly.
            if ! mv "$target" "$backup"; then
                log "Unable to back up Zellij config; deployment skipped."
                return 1
            fi
            log "Backed up existing Zellij config to $backup"
        fi

        if "$mise" -C / dot apply --yes; then
            return 0
        fi
        # If mise fails before replacing the target, put its original back.
        if [[ -n "$backup" && ! -e "$target" && ! -L "$target" ]]; then
            if mv "$backup" "$target"; then
                log 'Restored original Zellij config after failed deployment.'
            else
                log "Could not restore Zellij config; original is safe at $backup"
            fi
        fi
        return 1
    }

    # Refuse a foreign Zellij symlink before consulting mise status: a status
    # command may consider a symlink present even when its source is unrelated.
    zellij_target="$HOME/.config/zellij/config.kdl"
    if [[ -L "$zellij_target" && ! "$zellij_target" -ef "$ROOT/.config/zellij/config.kdl" ]]; then
        log "Zellij config is a foreign symlink; leaving it untouched: $zellij_target"
    elif "$mise" -C / dot status --missing >/dev/null 2>&1; then
        log 'Reviewed mise-managed dotfiles are already applied.'
    elif "$mise" -C / dot apply --dry-run --force; then
        if confirm 'Apply the reviewed dotfiles (backing up an existing regular Zellij config)?'; then
            if ! apply_reviewed_dotfiles; then
                log 'Mise dotfile deployment failed; review any remaining conflicts and backups.'
            fi
        else
            log 'Dotfile deployment declined or noninteractive.'
        fi
    else
        log 'Mise dotfile preview failed; skipping dotfiles and continuing tool setup.'
    fi
    if command -v zsh >/dev/null 2>&1 && zsh --version >/dev/null 2>&1; then
        if [[ -L "$zsh_target" && "$zsh_target" -ef "$zsh_source" ]]; then
            zsh_config_status='applied'
        else
            zsh_config_status='not applied'
        fi
    fi

    # Iterate via fd 3 to leave terminal stdin available for per-tool approval.
    while IFS= read -r spec <&3; do
        [[ -n "$spec" ]] || continue
        if "$mise" -C / install --dry-run-code "$spec"; then
            log "$spec is already installed."
            continue
        else
            status=$?
        fi
        [[ "$status" -eq 1 ]] || die "Could not inspect the installed $spec version."
        if confirm "Install missing $spec from the reviewed machine manifest?"; then
            "$mise" -C / install "$spec" || die "mise could not install $spec."
            "$mise" -C / install --dry-run-code "$spec" ||
                die "mise did not report $spec installed after the approved command."
        else
            log "Skipped $spec installation."
        fi
    done 3<<<"$tool_specs"

    # The prompt is an optional Git checkout, not a native installed executable.
    # Only offer it when our reviewed Zsh startup file is actually active.
    if [[ "$zsh_config_status" == 'already applied' || "$zsh_config_status" == applied* ]]; then
        bash "$ROOT/scripts/setup/setup-prompt.sh" --apply ||
            die "Optional prompt setup failed; check the preceding error."
        bash "$ROOT/scripts/setup/setup-fonts.sh" --apply ||
            die "Optional font setup failed; check the preceding error."
        bash "$ROOT/scripts/setup/setup-autosuggestions.sh" --apply ||
            die "Optional autosuggestions setup failed; check the preceding error."
    else
        log 'Skipping optional Zsh plugins and font: reviewed Zsh startup is not active.'
    fi

    # Keep Neovim failures visible without blocking unrelated setup.
    nvim_status='ok'
    if ! setup_nvim; then
        nvim_status='failed'
    fi

    # Desktop keyboard preferences are independent of mise-managed dotfiles.
    # The helper only offers a mapping for a detected supported Linux desktop.
    bash "$ROOT/scripts/setup/keyboard.sh" --apply ||
        die "Keyboard setup failed; check the preceding error."

    # Changing the login shell is independent of package and dotfile setup.
    # Run this last so any earlier approval answers cannot apply to chsh.
    # chsh changes only this user's login account and may ask for a password.
    offer_default_zsh "$platform" /etc/shells

    log "Bootstrap complete. Zsh configuration: $zsh_config_status."
    if [[ "$nvim_status" == failed ]]; then
        printf '[error] Bootstrap completed with Neovim setup failure.\n' >&2
        return 1
    fi
}

main "$@"
