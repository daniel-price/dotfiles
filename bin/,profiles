#!/usr/bin/env bash
# Discover and add explicitly selected personal mise profiles.
set -euo pipefail

ROOT=$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)
# shellcheck source=lib/common.sh
source "$ROOT/lib/common.sh"

# Keep the machine-local selection in its documented simple format.
add_environment() {
    local rc=$1 name=$2 line env='[]' found=false contents='' updated tmp
    local pattern='^[[:blank:]]*env[[:blank:]]*=[[:blank:]]*(\[[^]]*\])[[:blank:]]*(#.*)?$'
    [[ ! -L "$rc" ]] || die "Refusing symlink: $rc"
    if [[ -e "$rc" ]]; then
        [[ -f "$rc" ]] || die "Not a regular file: $rc"
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" =~ $pattern ]]; then
                [[ "$found" == false ]] || die "Duplicate env declaration: $rc"
                found=true
                env=$(jq -ce 'select(type == "array" and all(.[]; type == "string" and test("^[A-Za-z0-9_-]+$")))' <<<"${BASH_REMATCH[1]}") || die "Edit complex env declaration manually: $rc"
            elif [[ "$line" =~ ^[[:blank:]]*(#.*)?$ ]]; then
                :
            else
                die "Edit complex mise settings manually: $rc"
            fi
            contents+="$line"$'\n'
        done <"$rc"
    fi
    if jq -e --arg name "$name" 'index($name) != null' <<<"$env" >/dev/null; then
        return 0
    fi
    updated=$(jq -c --arg name "$name" '. + [$name]' <<<"$env") || return 1
    mkdir -p "$(dirname "$rc")" || return 1
    tmp=$(mktemp "$rc.XXXXXX") || return 1
    if ! {
        if [[ "$found" == true ]]; then
            while IFS= read -r line; do
                if [[ "$line" =~ $pattern ]]; then
                    printf 'env = %s %s\n' "$updated" "${BASH_REMATCH[2]:-}"
                else
                    printf '%s\n' "$line"
                fi
            done < <(printf '%s' "$contents")
        else
            printf 'env = %s\n%s' "$updated" "$contents"
        fi
    } >"$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    mv -f "$tmp" "$rc" || { rm -f "$tmp"; return 1; }
}

main() {
    if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then
        printf '%s\n' 'Usage: ,profiles' 'Discover and add personal profiles owned by your authenticated GitHub account.'
        return
    fi
    [[ $# -eq 0 ]] || die 'Unexpected argument. Use --help.'
    [[ -t 0 && -t 1 ]] || die 'An interactive terminal is required.'
    local tool owner repos selected repo name target manifest config_dir rc
    local added=false
    for tool in git gh gum mise jq; do
        command -v "$tool" >/dev/null || die "$tool is required; run Base bootstrap first."
    done
    config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mise"
    rc="$config_dir/miserc.local.toml"
    owner=$(gh api --hostname github.com user --jq .login) || die 'Authenticate with gh auth login first.'
    [[ "$owner" =~ ^[A-Za-z0-9-]+$ ]] || die 'Invalid GitHub login.'
    repos=$(gh api --hostname github.com --paginate 'user/repos?affiliation=owner&per_page=100' --jq '
        .[] | select(.archived == false and (.name | test("^\\.dotfiles-profile-personal(-[a-z0-9]+)*$"))) | .full_name
    ') || die 'Could not discover profiles.'
    repos=$(printf '%s\n' "$repos" | awk -v owner="$owner" 'index($0, owner "/") == 1' | sort -u)
    [[ -n "$repos" ]] || { log 'No matching personal profile repositories found.'; return; }
    selected=$(printf '%s\n' "$repos" | gum choose --no-limit --header 'Select personal profiles to add (space to toggle, enter to confirm)') || return 0
    [[ -n "$selected" ]] || return 0
    while IFS= read -r repo <&3; do
        [[ "$repo" == "$owner/"* && "${repo#*/}" =~ ^\.dotfiles-profile-personal(-[a-z0-9]+)*$ ]] || die 'Invalid selection.'
        grep -Fxq "$repo" <<<"$repos" || die 'Selection was not discovered.'
        name="${repo#*/.dotfiles-profile-}"
        target="$config_dir/conf.d/$name"
        manifest="$target/mise.$name.toml"
        if [[ -e "$target" || -L "$target" ]]; then
            [[ ! -L "$target" && -d "$target/.git" ]] || die "Existing path is not a profile checkout: $target"
            case "$(git -C "$target" remote get-url origin)" in
                "https://github.com/$repo.git" | "https://github.com/$repo" | "git@github.com:$repo.git") ;;
                *) die "Existing checkout has a different origin: $target" ;;
            esac
            log "Using existing checkout without updating it: $target"
        else
            confirm "Clone $repo into $target?" || continue
            mkdir -p "$config_dir/conf.d"
            gh repo clone "$repo" "$target" || die 'Clone failed.'
        fi
        [[ -f "$manifest" && ! -L "$manifest" ]] || die "Expected regular profile manifest: $manifest"
        log "Review the checkout at $target before trusting it."
        confirm "Trust $manifest (may execute profile code)?" || continue
        mise trust "$manifest" || die 'Trust failed.'
        confirm "Add $name to $rc, preserving existing environments?" || continue
        add_environment "$rc" "$name" || die 'Could not update selection.'
        added=true
    done 3<<<"$selected"
    [[ "$added" == true ]] || return 0

    mise -C / install --dry-run || die 'Tool preview failed.'
    if confirm 'Install the previewed tools?'; then
        mise -C / install || die 'Tool installation failed.'
    fi
    mise -C / dot apply --dry-run || die 'Dotfile preview failed.'
    if confirm 'Apply the previewed dotfiles (without forcing conflicts)?'; then
        mise -C / dot apply || die 'Dotfile application failed.'
    fi
    log 'Start a new shell with exec zsh to activate the selection.'
}

